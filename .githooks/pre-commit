#!/bin/sh
# 提交前扫描暂存区里的密钥（gitleaks）。安装：https://github.com/gitleaks/gitleaks#installing
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks git --pre-commit --staged --redact --no-banner -v || { echo "❌ gitleaks 发现疑似密钥，提交已阻止（确认误报可加入 .gitleaksignore）"; exit 1; }
else
  echo "⚠️ 未安装 gitleaks，跳过密钥扫描（CI 仍会扫描）。建议安装：brew install gitleaks"
fi
# 额外防线：不允许提交 .env / .dev.vars / cloudflare.env
if git diff --cached --name-only | grep -E '(^|/)(\.env(\..+)?|\.dev\.vars|cloudflare\.env)$' | grep -v '\.env\.example$'; then
  echo "❌ 不允许提交环境变量/密钥文件"; exit 1
fi
