{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "Asia/Shanghai",
  "packageRules": [
    {
      "description": "Pi 不自动升级：开发时手动跑 scripts/pi-update.mjs（docs/decisions/0012）",
      "matchPackageNames": [
        "@earendil-works/{/,}**"
      ],
      "enabled": false
    },
    {
      "description": "Hindsight 不自动升级：开发时手动跑 scripts/hindsight-update.mjs（docs/decisions/0012）",
      "matchPackageNames": [
        "@vectorize-io/hindsight{/,}**",
        "hindsight-embed",
        "hindsight-api-slim"
      ],
      "enabled": false
    },
    {
      "matchPackageNames": [
        "@tencent-weixin/openclaw-weixin"
      ],
      "groupName": "微信 ClawBot 官方插件",
      "schedule": [
        "at any time"
      ],
      "labels": [
        "third-party",
        "wechat"
      ],
      "minimumReleaseAge": "2 days",
      "prBodyNotes": [
        "只复用协议层；CI 跑 packages/server/test/clawbot.test.ts。官方若开始用到新的 OpenClaw SDK 函数，需在 packages/openclaw-shim 补上。"
      ]
    },
    {
      "matchPackageNames": [
        "openclaw"
      ],
      "enabled": false
    },
    {
      "matchDepTypes": [
        "devDependencies"
      ],
      "groupName": "dev dependencies",
      "schedule": [
        "before 9am on monday"
      ]
    }
  ]
}
