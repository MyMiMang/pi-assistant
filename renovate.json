{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Asia/Shanghai",
  "packageRules": [
    { "matchPackageNames": ["@earendil-works/{/,}**"], "groupName": "Pi", "schedule": ["at any time"], "labels": ["pi"], "minimumReleaseAge": "1 day" },
