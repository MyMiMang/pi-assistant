# Pi Assistant不读取任何模型 API Key 环境变量：所有模型账号都在 App 里登录（凭据加密保存在本机）。
PIA_PORT=8787
# PIA_DATA_DIR=./data            # 默认：macOS ~/Library/Application Support/Pi Assistant，Windows %APPDATA%\Pi Assistant，Linux ~/.local/share/pi-assistant
# PIA_SANDBOX=workspace          # workspace | docker
# PIA_CLOUDFLARED=/path/to/cloudflared
# PIA_ENTRY_DOMAIN=                # 可选：已部署的远程入口（通常在 App「设置 → 远程入口」里一键部署，无需设置）
# PIA_MOCK=1                     # 仅开发/测试：启用 Mock 模型
TZ=Asia/Shanghai
