{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pi Assistant",
  "identifier": "com.piassistant.app",
  "version": "0.1.0",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/node"
    ],
    "resources": {
      "../../../dist-app/": "app/"
    },
    "createUpdaterArtifacts": true,
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "publisher": "Pi Assistant",
    "shortDescription": "能操作电脑、什么都能做的本地助理"
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/MyMiMang/pi-assistant/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQyMEI1RURCMzg0OEQ5QTcKUldTbjJVZzQyMTRMMGpVeXBvaU4wOGpGVWJTaEhJYWFxc2dqVzVJNTFPK0hBYUZIeUhtZk5lSjYK"
    }
  }
}
