{
  "name": "pi-assistant",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run build -w @huhao/web && HUHAO_MOCK=1 npm run dev -w @huhao/server",
    "dev:web": "npm run dev -w @huhao/web",
    "build": "npm run build -w @huhao/web",
    "start": "npm run start -w @huhao/server",
    "test": "npm test -w @huhao/server",
    "typecheck": "npm run typecheck -w @huhao/server && tsc --noEmit -p apps/web",
    "e2e": "npm run build && node e2e/run.mjs",
    "check:pi": "node scripts/check-pi.mjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "scan:secrets": "gitleaks git --redact --no-banner . && gitleaks dir --redact --no-banner --max-target-megabytes 5 apps packages scripts docs e2e"
  }
}
